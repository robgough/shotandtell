# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — it never leaves your machine.

# Your 10-character Apple Developer Team ID. Find it in
#   Xcode → Settings → Accounts → your Apple ID,
# or by running `codesign -dv` on any app you've already signed.
#
# When set, builds are signed with your certificate and the macOS Screen
# Recording grant survives rebuilds. When unset, the build falls back to
# ad-hoc signing and you'll re-grant screen recording after every clean build.
SHOTANDTELL_TEAM_ID=

# Optional: pin the exact signing identity (SHA-1 from
# `security find-identity -v -p codesigning`) and use Manual signing, so CLI
# builds don't need Xcode's GUI provisioning.
#
# Prefer the certificate your *releases* are signed with. macOS keys the Screen
# Recording grant to the signing requirement, so a local build signed like a
# release inherits the grant a released build already has, instead of showing
# the permission dialog every time you switch between the two.
SHOTANDTELL_CODE_SIGN_IDENTITY=
SHOTANDTELL_CODE_SIGN_STYLE=Manual
