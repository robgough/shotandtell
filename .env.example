# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — it never leaves your machine.
#
# Both variables below are needed for a genuinely signed build. Setting only the
# team ID leaves CODE_SIGN_IDENTITY empty, which still means ad-hoc signing —
# `./gen` warns when that's the case.

# Your 10-character Apple Developer Team ID. Find it in
#   Xcode → Settings → Accounts → your Apple ID,
# or by running `codesign -dv` on any app you've already signed.
SHOTANDTELL_TEAM_ID=

# The exact signing identity: the SHA-1 from
# `security find-identity -v -p codesigning`. Manual style so CLI builds don't
# need Xcode's GUI provisioning.
#
# macOS keys the Screen Recording grant to the bundle ID and the code-signing
# requirement. Ad-hoc signatures change on every build, so the grant is revoked
# every time; a real certificate keeps it. Prefer the certificate your releases
# are signed with, so local and released builds share one grant instead of
# prompting each time you switch between them.
SHOTANDTELL_CODE_SIGN_IDENTITY=
SHOTANDTELL_CODE_SIGN_STYLE=Manual
