#!/usr/bin/env bash
# Regenerate ShotAndTell.xcodeproj from project.yml.
#
# Loads .env (if present) first so xcodegen can resolve ${SHOTANDTELL_TEAM_ID}
# and friends. Without it xcodegen sees those as empty and the build falls back
# to ad-hoc signing.

set -euo pipefail
cd "$(dirname "$0")"

if [ -f .env ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
fi

# The *identity* is what decides whether the build is really signed — a team ID
# on its own still leaves CODE_SIGN_IDENTITY empty, and therefore ad-hoc. Warn
# on the variable that actually matters, not the one that looks like it does.
if [ -z "${SHOTANDTELL_CODE_SIGN_IDENTITY:-}" ]; then
    echo "⚠️  SHOTANDTELL_CODE_SIGN_IDENTITY not set — the build will use ad-hoc signing." >&2
    echo "    It still builds and runs sandboxed, but the signature changes every" >&2
    echo "    build, so macOS re-prompts for Screen Recording each time." >&2
    echo "    Set SHOTANDTELL_TEAM_ID *and* SHOTANDTELL_CODE_SIGN_IDENTITY in .env" >&2
    echo "    to fix it — see .env.example." >&2
    echo "" >&2
fi

# Fall back to ad-hoc signing rather than *no* signing. An unsigned binary
# can't carry entitlements at all, so an empty identity here would quietly
# produce a build with no sandbox — which both warns at build time and hides
# sandbox violations until submission. Ad-hoc signing applies the entitlements
# properly; the only thing it costs is a signature that changes every build.
: "${SHOTANDTELL_CODE_SIGN_IDENTITY:=-}"
: "${SHOTANDTELL_CODE_SIGN_STYLE:=Manual}"
export SHOTANDTELL_CODE_SIGN_IDENTITY SHOTANDTELL_CODE_SIGN_STYLE

exec xcodegen generate "$@"
